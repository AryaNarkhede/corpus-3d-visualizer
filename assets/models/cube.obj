# Default test model – unit cube centred at origin
# 8 vertices, 6 faces (2 triangles each), normals included

v  0.5  0.5  0.5
v -0.5  0.5  0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5

vn  0  0  1
vn  0  0 -1
vn  0  1  0
vn  0 -1  0
vn  1  0  0
vn -1  0  0

# Front
f 1//1 2//1 3//1
f 1//1 3//1 4//1
# Back
f 5//2 7//2 6//2
f 5//2 8//2 7//2
